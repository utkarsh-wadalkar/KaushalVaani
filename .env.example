# EchoQuery environment template
# Copy this file to .env and replace only the placeholder values.
# Never commit .env or expose backend credentials through VITE_* variables.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=EchoQuery
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
SECRET_KEY=

# -----------------------------------------------------------------------------
# Speech-to-text: Sarvam Saaras v3
# Audio is streamed to Saaras, but RAG starts only after a finalized utterance.
# Use "unknown" to enable language detection. Mode remains "transcribe" so the
# user's language is preserved rather than translated to English.
# -----------------------------------------------------------------------------
STT_PROVIDER=sarvam
SARVAM_API_KEY=replace-with-sarvam-api-key
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE_CODE=unknown
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_INPUT_CODEC=pcm_s16le
SARVAM_STT_TIMEOUT_SECONDS=30

# Optional STT adapter used only for testing; not required for production.
STT_TEST_PROVIDER=voxtral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=wss://api.mistral.ai
MISTRAL_STT_MODEL=voxtral-mini-transcribe-realtime-2602

# -----------------------------------------------------------------------------
# Answer generation
# Sarvam STT and chat completion use the same SARVAM_API_KEY.
# -----------------------------------------------------------------------------
LLM_PROVIDER=sarvam
LLM_MODEL=sarvam-105b


# -----------------------------------------------------------------------------
# Multilingual embeddings and retrieval
# The embedding model is a configurable benchmark baseline, not a frozen winner.
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

RAG_TOP_K=20
RAG_RERANK_TOP_K=5
RAG_LATENCY_TARGET_MS=200

RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# -----------------------------------------------------------------------------
# Qdrant
# For local Qdrant use http://localhost:6333 and leave the API key empty.
# For Qdrant Cloud replace the URL and database API key below.
# -----------------------------------------------------------------------------
VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=echoquery_chunks_v1
VECTOR_DB_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Dataset and local artifacts
# MSMARCO-XI is public; HF_TOKEN is optional but useful for authenticated access.
# -----------------------------------------------------------------------------
HF_TOKEN=
HF_DATASET_NAME=ai4bharat/MSMARCO-XI
DATA_DIR=05-data
RAW_DATA_DIR=05-data/raw
PROCESSED_DATA_DIR=05-data/processed
CHUNKS_DIR=05-data/chunks
INDEXES_DIR=05-data/indexes

# -----------------------------------------------------------------------------
# WebSocket and latency evaluation
# P100 is the maximum observed value, not a best-case run.
# -----------------------------------------------------------------------------
WS_PATH=/ws
WS_MAX_AUDIO_BYTES=10485760

LATENCY_PRIMARY_SCOPE=final_transcript_to_final_answer
LATENCY_SECONDARY_SCOPE=audio_end_to_final_answer
LATENCY_PERCENTILES=50,70,100
LATENCY_BENCHMARK_QUERIES=100
